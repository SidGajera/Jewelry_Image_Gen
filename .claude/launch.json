{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lunivae-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "D:/DiamondWebsite", "run", "dev"],
      "port": 3000
    },
    {
      "name": "lunivae-prev-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "D:/DiamondWebsite-prevui", "run", "dev", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "lunivae-api",
      "runtimeExecutable": "C:/php/php.exe",
      "runtimeArgs": ["D:/DiamondWebsite/backend/crm/artisan", "serve", "--host=127.0.0.1", "--port=8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
