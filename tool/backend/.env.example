# Copy to tool/.env and fill in. tool/.env is git-ignored — never commit real keys.
HIGGSFIELD_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional path overrides (relative paths resolve against the repo root; absolute
# paths, including mounted cloud/network drives, work as-is). Uncomment to override
# the default ./workspace/<name> locations. See tool/backend/lib/config/paths.py.
# SOURCE_DIR=./workspace/source
# REFERENCE_DIR=./workspace/reference
# INPUT_DIR=./workspace/input
# OUTPUT_DIR=./workspace/output
# LOGO_DIR=./assets/logo
# BACKGROUND_DIR=./assets/background
# CACHE_DIR=./workspace/cache
# TEMP_DIR=./workspace/temp
# DELIVERY_DIR=./workspace/deliveries
# JOBS_DIR=./tool/backend/jobs
