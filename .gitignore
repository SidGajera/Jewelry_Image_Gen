# Nearly nothing is ignored (per user request) — repo tracks everything EXCEPT real secrets.
# The tool needs live API keys / a Google service-account; committing those would leak them.
tool/.env
tool/backend/.env
tool/backend/service-account.json
tool/backend/.venv/

# Python build artifacts (regenerated; never reviewed) — not project content.
__pycache__/
*.pyc

# Generated image outputs / composite intermediates — NEVER commit generated images.
workspace/output/*
!workspace/output/.gitkeep
workspace/temp/
**/CUT_*.png
hf_*.png

# Lightweight repo: never commit deliverable renders or source CAD/reference images (large binaries)
deliveries/
workspace/golden/**/*.png
workspace/golden/**/*.jpg
workspace/golden/**/*.jpeg
workspace/golden/**/*.webp
hero_jewelry.png

# Belt-and-suspenders: never commit ANY generated/heavy media anywhere under workspace/
workspace/cache/
workspace/**/*.png
workspace/**/*.jpg
workspace/**/*.jpeg
workspace/**/*.webp
workspace/**/*.mp4
workspace/**/*.mov
workspace/**/*.glb
!workspace/**/.gitkeep

# Source CAD/reference stills are heavy binaries — never commit
workspace/**/*.avif
workspace/golden/*.avif
workspace/golden/*.jpg
workspace/golden/*.jpeg
workspace/golden/*.png
*.avif
outputs/
renders/
*.png
*.jpg
*.jpeg
*.webp
*.mp4
tmp/
cache/
.venv/
node_modules/
.DS_Store

# Synthetic gate fixtures are regenerated by tests/make_fixtures.py — never commit images
tests/golden/*.png
workspace/golden/**/genplan_*.json

tests/golden/source_clean_cad/*
tests/golden/source_watermarked/*
tests/golden/source_worn_photo/*
workspace/golden/**/ref/*

build/*_urls.json
build/*_state.json

models/
