# Nearly nothing is ignored (per user request) — repo tracks everything EXCEPT real secrets.
# The tool needs live API keys / a Google service-account; committing those would leak them.
tool/.env
tool/backend/.env
tool/backend/service-account.json
tool/backend/.venv/

# Python build artifacts (regenerated; never reviewed) — not project content.
__pycache__/
*.pyc

# CAD renders are large binaries; regenerate with scripts/cad_render.py
workspace/cad_renders/
